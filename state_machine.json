{
    "Comment": "State machine for the pipeline orchestration",
    "StartsAt": "WorkingFileFunction",
    "States": { 
    "WorkingFileFunction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:lambda_function",
        "Payload.$": "$"
      },
      "End": true
    }
  }
}
